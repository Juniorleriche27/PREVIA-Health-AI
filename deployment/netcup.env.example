# Copy to /opt/env/previa-health-ai.env on the Netcup server.
# Use the exact Vercel production origin; comma-separate additional origins.
PREVIA_CORS_ORIGINS=https://your-previa-frontend.vercel.app
PREVIA_RELEASE=latest
# Server-side only. Never expose this variable to Vercel or NEXT_PUBLIC_*.
PREVIA_KNOWLIA_API_KEY=replace-with-a-dedicated-knowlia-public-api-key

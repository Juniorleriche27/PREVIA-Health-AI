# Browser-visible service URLs (never put secrets in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8765
NEXT_PUBLIC_AI_API_URL=http://127.0.0.1:8766

# Server-only provider registry. No provider is enabled unless explicitly added.
PREVIA_LLM_CONFIG_FILE=/app/config/providers.local.json
PREVIA_CORS_ORIGINS=https://previa.example.org
# PREVIA_LLM_KEY_EXAMPLE=replace-at-deployment-time
